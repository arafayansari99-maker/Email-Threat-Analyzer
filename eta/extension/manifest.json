{
  "manifest_version": 3,
  "name": "ETA — Email Threat Analyzer",
  "version": "2.0.0",
  "description": "Real-time phishing detection for Gmail",
  "permissions": ["activeTab", "storage", "scripting", "notifications", "alarms"],
  "host_permissions": ["https://mail.google.com/*", "https://*.onrender.com/*", "http://127.0.0.1:8001/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ETA Threat Analyzer"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png",
    "256": "icon256.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://mail.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}