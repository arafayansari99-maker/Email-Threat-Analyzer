# ─────────────────────────────────────────────────────────────────────────────
# ETA Email Threat Analyzer — Backend Environment Variables
# Copy to eta/backend/.env and fill in real values.
# NEVER commit the actual .env file to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev / single-server):
DATABASE_URL=sqlite:///./eta.db
# PostgreSQL (production recommended):
# DATABASE_URL=postgresql://eta_user:STRONG_PASSWORD@localhost:5432/eta_db

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED — generate a new key for every environment, never reuse:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# Optional: separate key for encrypting stored IMAP passwords.
# Falls back to JWT_SECRET_KEY if not set.
# IMAP_ENCRYPT_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to disable /docs, /redoc, and the OpenAPI schema
ENVIRONMENT=development

# ── First-Run Admin Account ───────────────────────────────────────────────────
# Set BEFORE first launch. Change the password immediately after first login.
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=ChangeThisImmediately!AtLeast16Chars

# ── Threat Intelligence API Keys (all optional) ───────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
HYBRID_ANALYSIS_API_KEY=
URLSCAN_API_KEY=
SAFE_BROWSING_API_KEY=

# ── LLM Narrative (optional — enables GPT-4o-mini threat assessment) ───────────
OPENAI_API_KEY=

# ── Email / SMTP (for password reset and scheduled reports) ───────────────────
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourorg.com
# SMTP_PASSWORD=your_smtp_password
