# This placeholder file is intentionally minimal.
# The actual backend environment template lives in eta/.env.example.
# Copy eta/.env.example to eta/backend/.env and fill in your real secret values.
# NEVER commit the actual .env file to git — it is already excluded by .gitignore.

# No secrets belong in frontend or root-level environment files.
# The frontend may only use VITE_API_URL to point to the backend API server.

# Example production backend URL (set in your deployment environment only):
VITE_API_URL=https://your-backend.example.com
